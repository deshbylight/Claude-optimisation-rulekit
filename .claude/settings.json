{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "bashOutputMaxChars": 5000,
  "outputStyle": "lean",
  "autoMemoryEnabled": false,
  "includeGitInstructions": false,
  "disableClaudeAiConnectors": true,
  "statusLine": {
    "type": "command",
    "command": "python \"$CLAUDE_PROJECT_DIR/Tools/ctx_usage.py\""
  },
  "env": {
    "RULEKIT_VERIFY_RE": "check_kit\\.py|unittest"
  },
  "skillOverrides": {
    "claude-in-chrome": "off",
    "docx": "off",
    "simplify": "off"
  },
  "permissions": {
    "deny": [
      "Artifact",
      "SendFeedback",
      "Workflow",
      "ScheduleWakeup",
      "ReportFindings",
      "ListAgents",
      "CronCreate",
      "CronDelete",
      "CronList",
      "RemoteTrigger",
      "PushNotification",
      "DesignSync",
      "EnterWorktree",
      "ExitWorktree",
      "NotebookEdit",
      "Glob",
      "Agent",
      "SendMessage"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/Tools/claude_read_guard.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/Tools/claude_shell_guard.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/Tools/claude_language_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/Tools/claude_topic_gate.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/Tools/claude_session_length.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/Tools/claude_commit_reminder.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/Tools/claude_verify_gate.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
